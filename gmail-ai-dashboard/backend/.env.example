# Azure AI Foundry & Model Configuration
AZURE_OPENAI_NANO_API_KEY=
AZURE_DECISION_API_KEY=
AZURE_EMBEDDING_SMALL_API_KEY=

GPT_MODEL_DEPLOYMENT=gpt-5-nano
CLASSIFICATION_MODEL_DEPLOYMENT=MCRO
EMBEDDING_MODEL_DEPLOYMENT=text-embedding-3-small

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional legacy / separate resource variables (backward compatible)
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_KEY=
AZURE_OPENAI_API_KEY=

LANGGRAPH_CHECKPOINT_PATH=./data/langgraph.sqlite
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mailbox-devLG
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# New Relic APM (optional; set the license key in deployment secrets)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Gmail AI Dashboard
NEW_RELIC_CONFIG_FILE=./newrelic.ini
GMAIL_MCP_ENABLED=true
GMAIL_MCP_MAX_MESSAGES=1000
GMAIL_MCP_TIMEOUT_SECONDS=30
# Interactive-answer latency controls
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0
LLM_MAX_COMPLETION_TOKENS=1600
RAG_RELEVANCE_PARALLELISM=2
# Set a stable random 32+ character secret to enable encrypted developer credentials.
# Changing it later makes saved personal database URLs and API keys unreadable.
DEVELOPER_SETTINGS_ENCRYPTION_KEY=
DEVELOPER_GEMINI_MODEL=gemini-2.5-flash
DEVELOPER_OPENAI_MODEL=gpt-5-nano
DEVELOPER_DAILY_CHAT_LIMIT=500
